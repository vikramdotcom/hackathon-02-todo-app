# Database Configuration
# For local development with SQLite:
DATABASE_URL=sqlite:///./todo_app.db
# For Hugging Face Spaces with persistent SQLite:
# DATABASE_URL=sqlite:///./data/todo_app.db
# For PostgreSQL (production with external DB):
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# JWT Configuration
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=Todo App Phase III - AI Chatbot

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://your-frontend.vercel.app"]

# Environment
ENVIRONMENT=development

# Authentication Toggle (for testing)
DISABLE_AUTH=False

# Phase III - OpenAI Configuration (AI Chat Feature)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Phase II API Configuration (for chat backend to call existing APIs)
PHASE2_API_BASE_URL=http://localhost:8001/api/v1

# Chat Configuration
CHAT_SESSION_TIMEOUT_MINUTES=30
CHAT_MAX_MESSAGES_PER_SESSION=20
CHAT_MAX_CONTEXT_TURNS=10

# Phase IV - Environment Variables Configuration
# Copy this file to .env and update with your values

# ============================================
# Backend Configuration
# ============================================

# Database connection string
# Format: postgresql://user:password@host:port/database
# For Kubernetes: Use service name as host (database)
# For local dev: Use localhost
DATABASE_URL=postgresql://postgres:postgres@database:5432/todo_db

# Application secret key for JWT tokens and encryption
# IMPORTANT: Generate a secure random key for production
# Generate with: openssl rand -base64 32
SECRET_KEY=your-secret-key-here-change-in-production

# OpenAI API key for AI chatbot functionality (optional)
# Get your key from: https://platform.openai.com/api-keys
# Leave empty to disable AI chatbot features
OPENAI_API_KEY=

# Logging level: debug, info, warning, error, critical
# Use 'debug' for development, 'info' for production
LOG_LEVEL=info

# Application environment: development, testing, production
ENVIRONMENT=development

# ============================================
# Frontend Configuration
# ============================================

# Public API URL accessible from browser
# For Kubernetes with Ingress: http://todo.local/api
# For local dev: http://localhost:8001
NEXT_PUBLIC_API_URL=http://todo.local/api

# Node environment: development, production
NODE_ENV=production

# ============================================
# Database Configuration
# ============================================

# PostgreSQL user
POSTGRES_USER=postgres

# PostgreSQL password
# IMPORTANT: Change this in production
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=postgres

# PostgreSQL database name
POSTGRES_DB=todo_db

# Database host (service name in Kubernetes)
DATABASE_HOST=database

# Database port
DATABASE_PORT=5432

# ============================================
# Kubernetes Configuration
# ============================================

# Kubernetes namespace
NAMESPACE=todo-app

# Docker image tags
# Use 'latest' for development
# Use semantic versioning for production (e.g., v1.0.0)
IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
BACKEND_IMAGE_TAG=latest

# Replica counts
FRONTEND_REPLICAS=2
BACKEND_REPLICAS=2
DATABASE_REPLICAS=1

# Resource limits (memory in Mi, CPU in millicores)
FRONTEND_MEMORY_REQUEST=256Mi
FRONTEND_MEMORY_LIMIT=512Mi
FRONTEND_CPU_REQUEST=250m
FRONTEND_CPU_LIMIT=500m

BACKEND_MEMORY_REQUEST=256Mi
BACKEND_MEMORY_LIMIT=512Mi
BACKEND_CPU_REQUEST=250m
BACKEND_CPU_LIMIT=500m

DATABASE_MEMORY_REQUEST=256Mi
DATABASE_MEMORY_LIMIT=512Mi
DATABASE_CPU_REQUEST=250m
DATABASE_CPU_LIMIT=500m

# ============================================
# Storage Configuration
# ============================================

# PersistentVolume storage class
STORAGE_CLASS=standard

# Database storage size
DATABASE_STORAGE_SIZE=5Gi

# ============================================
# Ingress Configuration
# ============================================

# Ingress host
INGRESS_HOST=todo.local

# Ingress class
INGRESS_CLASS=nginx

# ============================================
# Minikube Configuration
# ============================================

# Minikube driver: docker, virtualbox, hyperv, kvm2
MINIKUBE_DRIVER=docker

# Minikube resources
MINIKUBE_CPUS=4
MINIKUBE_MEMORY=8192
MINIKUBE_DISK_SIZE=20g

# ============================================
# Development Configuration
# ============================================

# Enable debug mode
DEBUG=false

# Enable hot reload (development only)
HOT_RELOAD=false

# Enable verbose logging
VERBOSE=false

# ============================================
# Testing Configuration
# ============================================

# Test database URL (separate from production)
TEST_DATABASE_URL=postgresql://postgres:postgres@database:5432/todo_db_test

# Test environment
TEST_ENVIRONMENT=testing

# ============================================
# CI/CD Configuration
# ============================================

# Docker registry (for pushing images)
DOCKER_REGISTRY=

# Docker registry username
DOCKER_USERNAME=

# Docker registry password
DOCKER_PASSWORD=

# Git branch for deployment
GIT_BRANCH=main

# ============================================
# Monitoring Configuration (Optional)
# ============================================

# Enable Prometheus metrics
ENABLE_METRICS=false

# Metrics port
METRICS_PORT=9090

# Enable health checks
ENABLE_HEALTH_CHECKS=true

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# ============================================
# Security Configuration
# ============================================

# Enable CORS
ENABLE_CORS=true

# Allowed origins (comma-separated)
CORS_ORIGINS=http://todo.local,http://localhost:3000

# Enable HTTPS (requires certificates)
ENABLE_HTTPS=false

# Certificate path (if HTTPS enabled)
TLS_CERT_PATH=

# Certificate key path (if HTTPS enabled)
TLS_KEY_PATH=

# ============================================
# Feature Flags
# ============================================

# Enable AI chatbot
ENABLE_AI_CHATBOT=true

# Enable user authentication
ENABLE_AUTH=true

# Enable multi-user support
ENABLE_MULTI_USER=true

# Enable real-time updates
ENABLE_REALTIME=false

# ============================================
# Notes
# ============================================

# 1. Never commit this file with real secrets to version control
# 2. Use different values for development, testing, and production
# 3. Generate secure random values for SECRET_KEY and POSTGRES_PASSWORD
# 4. Keep OPENAI_API_KEY secure and never expose it publicly
# 5. Update NEXT_PUBLIC_API_URL based on your deployment environment
# 6. Adjust resource limits based on your cluster capacity
# 7. Use semantic versioning for IMAGE_TAG in production

# ============================================
# Environment-Specific Examples
# ============================================

# Development:
# - DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_db_dev
# - NEXT_PUBLIC_API_URL=http://localhost:8001
# - LOG_LEVEL=debug
# - FRONTEND_REPLICAS=1
# - BACKEND_REPLICAS=1

# Testing:
# - DATABASE_URL=postgresql://postgres:test-password@database:5432/todo_db_test
# - NEXT_PUBLIC_API_URL=http://todo-test.local/api
# - LOG_LEVEL=info
# - FRONTEND_REPLICAS=2
# - BACKEND_REPLICAS=2

# Production:
# - DATABASE_URL=postgresql://postgres:secure-password@database:5432/todo_db
# - NEXT_PUBLIC_API_URL=https://todo.example.com/api
# - LOG_LEVEL=warning
# - FRONTEND_REPLICAS=3
# - BACKEND_REPLICAS=3
# - Use external secret management (Vault, Sealed Secrets)

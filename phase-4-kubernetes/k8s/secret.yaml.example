apiVersion: v1
kind: Secret
metadata:
  name: todo-app-secrets
  namespace: todo-app
  labels:
    app: todo-app
type: Opaque
stringData:
  # Database credentials
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "postgres"
  DATABASE_URL: "postgresql://postgres:postgres@database:5432/todo_db"

  # Backend secrets
  SECRET_KEY: "your-secret-key-here-change-in-production"

  # OpenAI API key (optional - for AI chatbot)
  OPENAI_API_KEY: "your-openai-api-key-here"

---
# Note: This is an example file. To use it:
# 1. Copy this file to secret.yaml
# 2. Update the values with your actual secrets
# 3. Apply with: kubectl apply -f k8s/secret.yaml
# 4. Add secret.yaml to .gitignore to prevent committing secrets

# Phase V Backend Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=todo-chatbot-backend
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ============================================================================
# Database Configuration (Neon PostgreSQL)
# ============================================================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/todo_db

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SQL_ECHO=false

# ============================================================================
# Dapr Configuration
# ============================================================================
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_ID=todo-backend
DAPR_APP_PORT=8000

# ============================================================================
# Redpanda Cloud (Kafka) Configuration
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=your-cluster.redpanda.cloud:9092
KAFKA_SASL_USERNAME=your-username
KAFKA_SASL_PASSWORD=your-password
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SECURITY_PROTOCOL=SASL_SSL

# Kafka Topics
KAFKA_TOPIC_TASK_EVENTS=task-events
KAFKA_TOPIC_REMINDERS=reminders
KAFKA_TOPIC_TASK_UPDATES=task-updates

# Consumer Group
KAFKA_CONSUMER_GROUP=todo-backend-group

# ============================================================================
# Authentication & Security
# ============================================================================
# JWT Configuration (for future implementation)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_RECURRING_TASKS=true
ENABLE_REMINDERS=true
ENABLE_AUDIT_TRAIL=true
ENABLE_WEBSOCKET=true

# ============================================================================
# Monitoring & Observability
# ============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090

# Logging
LOG_FORMAT=json
LOG_FILE=/var/log/todo-backend.log

# ============================================================================
# External Services
# ============================================================================
# Notification Service (for future implementation)
NOTIFICATION_SERVICE_URL=http://notification-service:8001

# WebSocket Service (for future implementation)
WEBSOCKET_SERVICE_URL=http://websocket-service:8002

# Audit Service (for future implementation)
AUDIT_SERVICE_URL=http://audit-service:8003

# ============================================================================
# Development Settings
# ============================================================================
# Set to true to enable auto-reload on code changes
AUTO_RELOAD=true

# Set to true to create sample data on startup
CREATE_SAMPLE_DATA=false

# ============================================================================
# Production Settings (override in production)
# ============================================================================
# ENVIRONMENT=production
# DEBUG=false
# RELOAD=false
# SQL_ECHO=false
# LOG_LEVEL=warning
